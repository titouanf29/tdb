# Configuration TDB Bot

# Token Telegram Bot (obligatoire)
# Obtenir sur: https://t.me/BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# API Keys (optionnelles)
NEWS_API_KEY=your_news_api_key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key

# Groq API (pour Assistant IA Trading - GRATUIT & ULTRA-RAPIDE)
# Obtenir sur: https://console.groq.com/ (6000 requêtes/jour gratuites)
GROQ_API_KEY=your_groq_api_key_here

# Reddit digest (read-only)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=captentdb-digest/1.0
REDDIT_SUBREDDITS=personalfinance,financialplanning,investing,stocks,trading,cryptocurrency,vosfinances,finance,bourse,FranceFIRE
REDDIT_KEYWORDS=beginner,debutant,debuter,start,new to,noob,help,budget,epargne,livret,assurance vie,ETF,tracker,PEA,placements,investir,argent,finance personnelle,gestion argent,credit,dette,loan,mortgage,emprunt
REDDIT_LOOKBACK_HOURS=6
REDDIT_MAX_POSTS=15
REDDIT_ALLOW_NSFW=false
REDDIT_MIN_SCORE=1
REDDIT_MIN_COMMENTS=0
REDDIT_REPLY_LANGUAGE=fr

# Digest schedule
DIGEST_TIMEZONE=Europe/Paris
DIGEST_HOURS=8,12,16,20
DIGEST_MINUTE=0
RUN_ONCE=false

# Digest output
REDDIT_DIGEST_OUT_DIR=services/reddit_digest_out
REDDIT_DIGEST_DB_PATH=database/reddit_digest.db

# Branding
CAPTENTDB_SITE_URL=https://captentdb.fr
CAPTENTDB_TAGLINE=Un outil simple pour apprendre la finance et organiser ses decisions.
