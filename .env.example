# Configuration TDB Bot

# Token Telegram Bot (obligatoire)
# Obtenir sur: https://t.me/BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# API Keys (optionnelles)
NEWS_API_KEY=your_news_api_key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key

# Groq API (pour Assistant IA Trading - GRATUIT & ULTRA-RAPIDE)
# Obtenir sur: https://console.groq.com/ (6000 requêtes/jour gratuites)
GROQ_API_KEY=your_groq_api_key_here

# Discord Webhooks (pour alertes marchés)
# Créer sur: Paramètres serveur Discord > Intégrations > Webhooks
# Canal principal (annonces ouverture/fermeture marchés)
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
# Canal opportunités (alertes trading, signaux, top movers)
DISCORD_WEBHOOK_OPPORTUNITIES=your_discord_webhook_opportunities_here
# Canal actualités (calendrier économique, news)
DISCORD_WEBHOOK_NEWS=your_discord_webhook_news_here
# Canal admin (logs, erreurs, statistiques - privé)
DISCORD_WEBHOOK_ADMIN=your_discord_webhook_admin_here
