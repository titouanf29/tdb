# Frontend Environment Variables

# Backend URL for the server-side proxy (read at runtime — no rebuild needed)
# Set this in Railway frontend service env vars to your backend's public URL
BACKEND_URL=http://localhost:8000

# Legacy / local dev fallback
NEXT_PUBLIC_API_URL=http://localhost:8000

# Telegram Bot info (for login widget)
NEXT_PUBLIC_TELEGRAM_BOT_NAME=your_bot_name

# WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
