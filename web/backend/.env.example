# ============================================================
# CaptenTDB — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secret-key-min-32-chars-change-this

# --- Database ---
# Leave empty to use SQLite (development only)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional: custom path for SQLite file (dev only)
# DATABASE_PATH=/path/to/trading_bot.db

# --- CORS / Frontend ---
# Comma-separated list of allowed origins (no trailing slash)
FRONTEND_URL=https://captentdb.fr
# ALLOWED_ORIGINS is read from FRONTEND_URL — no separate variable needed

# --- Stripe Payments ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- AI / LLM ---
GROQ_API_KEY=gsk_...
MISTRAL_API_KEY=...

# --- Market Data ---
UNSPLASH_ACCESS_KEY=...

# --- Admin ---
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@example.com

# --- Environment ---
# Set to "production" in prod to enable HSTS and disable /docs
ENV=development

# --- Email (optional) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=...
# SMTP_FROM=noreply@captentdb.fr

# Notifications push (navigateur et application installée). Générées par :
#   python scripts/generer_cles_vapid.py
# À poser dans les variables du service, jamais dans le dépôt. Sans elles,
# les notifications restent dans le site.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUJET=mailto:contact@captentdb.fr
