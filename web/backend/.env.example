# ============================================================
# CaptenTDB — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secret-key-min-32-chars-change-this

# --- Database ---
# Leave empty to use SQLite (development only)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional: custom path for SQLite file (dev only)
# DATABASE_PATH=/path/to/trading_bot.db

# --- CORS / Frontend ---
# Comma-separated list of allowed origins (no trailing slash)
FRONTEND_URL=https://captentdb.fr
# ALLOWED_ORIGINS is read from FRONTEND_URL — no separate variable needed

# --- Stripe Payments ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── L'éditeur et l'ouverture du Premium (voir api/legal.py) ─────────────────
# Tant que EDITEUR_STATUT n'est pas posé ET que la liste de contrôle n'est pas
# complète (Admin → Exploitation → « Ouverture du Premium »), rien n'est
# vendu et tout le monde a les limites Premium gratuitement.
# Avec une clé sk_test_…, seuls les administrateurs peuvent essayer le
# paiement (cartes de test Stripe) ; l'offre reste fermée au public.
EDITEUR_STATUT=non_immatricule          # micro_entreprise le jour de l'immatriculation
EDITEUR_NOM_PUBLIC=CaptenQwark
EDITEUR_IDENTITE=                       # Prénom Nom (« EI » est ajouté automatiquement)
EDITEUR_ADRESSE=
EDITEUR_EMAIL=
EDITEUR_TELEPHONE=
EDITEUR_SIREN=
EDITEUR_TVA=                            # vide = franchise en base (art. 293 B du CGI)
MEDIATEUR_NOM=
MEDIATEUR_ADRESSE=
MEDIATEUR_SITE=
PREMIUM_PRIX_MENSUEL=5                  # doit être le prix de STRIPE_PRICE_ID
CGV_VERSION=2.0
API_PUBLIC_URL=https://api.captentdb.fr  # pour afficher l'adresse du webhook dans l'admin

# --- AI / LLM ---
GROQ_API_KEY=gsk_...
MISTRAL_API_KEY=...

# --- Market Data ---
UNSPLASH_ACCESS_KEY=...

# --- Admin ---
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@example.com

# --- Environment ---
# Set to "production" in prod to enable HSTS and disable /docs
ENV=development

# --- Email (optional) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=...
# SMTP_FROM=noreply@captentdb.fr

# Notifications push (navigateur et application installée). Générées par :
#   python scripts/generer_cles_vapid.py
# À poser dans les variables du service, jamais dans le dépôt. Sans elles,
# les notifications restent dans le site.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUJET=mailto:contact@captentdb.fr
