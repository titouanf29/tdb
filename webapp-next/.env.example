# ── Admin ────────────────────────────────────────────────────────────────────
# Mot de passe pour accéder à la section /admin
ADMIN_PASSWORD=change-me-strong-password
# Secret aléatoire pour signer le cookie de session (min 32 caractères)
ADMIN_SECRET=change-me-random-secret-at-least-32-chars

NEXT_PUBLIC_SITE_URL=https://captentdb.fr
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/
NEXT_PUBLIC_DISCORD_URL=https://discord.com/
# Must be an HTTPS URL to an external host (SSRF-safe validation is enforced at runtime)
TRACKING_WEBHOOK_URL=

# Google Analytics 4 — Measurement ID (format: G-XXXXXXXXXX)
# Créer une propriété sur https://analytics.google.com
NEXT_PUBLIC_GA_ID=

# Google Search Console — Code de vérification (meta tag, sans guillemets)
# Récupérer sur https://search.google.com/search-console → Ajouter propriété → Balise HTML
NEXT_PUBLIC_GSC_VERIFICATION=

SITE_HOST=your-domain.com
ACME_EMAIL=ops@example.com

HEALTHCHECK_URL=http://127.0.0.1:3000/api/health
HEALTHCHECK_INTERVAL_MS=60000
HEALTHCHECK_TIMEOUT_MS=5000
# Must be an HTTPS URL to an external host (SSRF-safe validation is enforced at runtime)
HEALTHCHECK_WEBHOOK_URL=