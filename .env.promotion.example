# ============================================================
#  Bot de Promotion captentdb.fr — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ============================================================

# ── Reddit API ──────────────────────────────────────────────
# Créer une app sur https://www.reddit.com/prefs/apps
# Type : "script"
REDDIT_CLIENT_ID=TON_CLIENT_ID_REDDIT
REDDIT_CLIENT_SECRET=TON_CLIENT_SECRET_REDDIT
REDDIT_USERNAME=NOM_DU_COMPTE_REDDIT_BOT
REDDIT_PASSWORD=MOT_DE_PASSE_REDDIT_BOT
REDDIT_USER_AGENT=captentdb-promoter/1.0 by u/NOM_DU_COMPTE

# ── Telegram (notifications admin uniquement) ───────────────
# Token du bot Telegram qui t'envoie les rapports
# Peut être le même bot que le trading bot, ou un bot dédié
ADMIN_TELEGRAM_TOKEN=TOKEN_BOT_TELEGRAM
# Ton propre ID Telegram (obtiens-le via @userinfobot)
# OU l'ID d'un groupe/channel privé si tu veux un groupe dédié
ADMIN_CHAT_ID=TON_ID_TELEGRAM

# ── Comportement ────────────────────────────────────────────
# DRY_RUN=true  → Mode test, scanne mais ne poste RIEN
# DRY_RUN=false → Mode live, poste vraiment sur Reddit
DRY_RUN=true

# Intervalle entre chaque cycle de scan complet (en secondes)
# Défaut : 600 (10 minutes)
SCAN_INTERVAL_SECONDS=600

# Délai minimum entre deux posts Reddit (en secondes)
# Défaut : 900 (15 minutes) — évite le ban
MIN_DELAY_BETWEEN_POSTS=900

# Maximum de posts par heure
# Défaut : 2 — rester discret
MAX_POSTS_PER_HOUR=2
