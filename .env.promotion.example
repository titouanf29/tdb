# ============================================================
#  Bot de Promotion captentdb.fr — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
#
#  ✅ AUCUNE APP REDDIT REQUISE — fonctionne avec l'API publique
# ============================================================

# ── Telegram (OBLIGATOIRE) ──────────────────────────────────
# Token du bot Telegram (créé via @BotFather)
ADMIN_TELEGRAM_TOKEN=TOKEN_BOT_TELEGRAM

# ID du channel/groupe privé qui reçoit toutes les alertes et rapports
# Le bot doit être ADMIN du channel pour pouvoir y poster
NOTIFICATION_CHAT_ID=-1003781965332

# Ton ID Telegram PERSO — seul autorisé à envoyer des commandes au bot
# (/promo_stats, /promo_pause, /promo_resume)
ADMIN_USER_ID=2064575502

# ── Mode de fonctionnement ──────────────────────────────────
# false (défaut) = MODE ALERTE
#   → Le bot t'envoie sur Telegram les posts pertinents + message à copier-coller
#   → Tu postes manuellement le commentaire sur Reddit
#   → Idéal pour les nouveaux comptes Reddit (pas de karma requis)
#
# true = MODE AUTO (nécessite compte Reddit avec karma)
#   → Le bot poste automatiquement les commentaires
#   → Requiert REDDIT_USERNAME et REDDIT_PASSWORD ci-dessous
AUTO_POST_MODE=false

# ── Reddit (uniquement pour MODE AUTO) ─────────────────────
# Compte Reddit avec lequel le bot va poster les commentaires
# Recommandé : attendre que le compte ait +30 jours et quelques karma
REDDIT_USERNAME=NOM_DU_COMPTE_REDDIT
REDDIT_PASSWORD=MOT_DE_PASSE_REDDIT

# ── Paramètres de scan ──────────────────────────────────────
# Mettre true pour tester sans rien poster ni envoyer (test local)
DRY_RUN=false

# Intervalle entre chaque cycle de scan complet (en secondes)
# Défaut : 600 (10 minutes)
SCAN_INTERVAL_SECONDS=600

# Délai minimum entre deux posts automatiques (MODE AUTO uniquement)
# Défaut : 900 (15 minutes) — évite le ban Reddit
MIN_DELAY_BETWEEN_POSTS=900

# Maximum de commentaires postés par heure (MODE AUTO uniquement)
MAX_POSTS_PER_HOUR=2
